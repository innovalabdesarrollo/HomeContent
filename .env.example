# MongoDB Atlas — el nombre de DB va en la URI (homecontent). No mezclar otras DBs.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/homecontent?retryWrites=true&w=majority

# API Express local (opcional) — puerto fijo. Si está ocupado, no mates el otro proceso.
PORT=3007

# Web (Next.js)
WEB_PORT=3008

# Cliente API:
# - Vercel / same-origin: dejar VACÍO
# - Local dual (Express en 3007): http://localhost:3007
NEXT_PUBLIC_API_URL=

# URL pública de uploads locales (solo Express local)
PUBLIC_API_URL=http://localhost:3007

# Cloudinary — REQUERIDO en Vercel para subir imágenes (FS efímero)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=homecontent
